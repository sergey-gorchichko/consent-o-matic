{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "centrumrowerowe": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#consentsBar"
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "#consentsBar",
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "OPEN_OPTIONS",
                "action": {
                    "type": "click",
                    "parent": {
                        "selector": "#consentsBar"
                    },
                    "target": {
                        "selector": "button.consent-link-button",
                        "textFilter": "Ustawienia"
                    }
                }
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "waitcss",
                            "target": {
                                "selector": ".settingsModalBox"
                            },
                            "retries": 10,
                            "waitTime": 200
                        },
                        {
                            "type": "consent",
                            "consents": [
                                {
                                    "type": "B",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": ".settingsModalBox input[name='statistics']"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": ".settingsModalBox label.switch[aria-label='Analityczne']"
                                        }
                                    }
                                },
                                {
                                    "type": "A",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": ".settingsModalBox input[name='functionality']"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": ".settingsModalBox label.switch[aria-label='Funkcjonalne i personalizacyjne']"
                                        }
                                    }
                                },
                                {
                                    "type": "F",
                                    "matcher": {
                                        "type": "checkbox",
                                        "target": {
                                            "selector": ".settingsModalBox input[name='marketing']"
                                        }
                                    },
                                    "toggleAction": {
                                        "type": "click",
                                        "target": {
                                            "selector": ".settingsModalBox label.switch[aria-label='Reklamowe']"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "SAVE_CONSENT",
                "action": {
                    "type": "click",
                    "parent": {
                        "selector": ".settingsModalBox"
                    },
                    "target": {
                        "selector": "button.custom",
                        "textFilter": "Akceptuję wybrane"
                    }
                }
            },
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "list",
                    "actions": [
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#consentsOverlay"
                            }
                        },
                        {
                            "type": "hide",
                            "target": {
                                "selector": "#consentsBar"
                            }
                        },
                        {
                            "type": "hide",
                            "target": {
                                "selector": ".settingsModalBox"
                            }
                        },
                        {
                            "type": "hide",
                            "target": {
                                "selector": ".settingsModalBoxOverlay"
                            }
                        }
                    ]
                }
            }
        ]
    }
}
